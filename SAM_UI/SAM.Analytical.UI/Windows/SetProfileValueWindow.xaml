<Window x:Class="SAM.Analytical.UI.SetProfileValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Set Value" Height="210" Width="300" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="33"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Value" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBox_Value" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" PreviewTextInput="NumberOnly_PreviewTextInput"/>

        <CheckBox x:Name="CheckBox_Append" Grid.Row="1" Grid.Column="1" Content="Append" VerticalAlignment="Center" Margin="0,2" Checked="CheckBox_Append_Changed" Unchecked="CheckBox_Append_Changed"/>

        <TextBlock x:Name="Label_StartIndex" Grid.Row="2" Grid.Column="0" Text="Start Index" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBox_StartIndex" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" PreviewTextInput="IntegerOnly_PreviewTextInput"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Count" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBox_Count" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" PreviewTextInput="IntegerOnly_PreviewTextInput"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click"/>
            <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" Margin="5,0,0,0" IsCancel="True" Click="Button_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

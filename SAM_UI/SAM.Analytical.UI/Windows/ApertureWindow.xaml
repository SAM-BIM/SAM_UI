<Window x:Class="SAM.Analytical.UI.ApertureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Analytical.UI"
        xmlns:wpf="clr-namespace:SAM.Core.UI.WPF;assembly=SAM.Core.UI.WPF"
        mc:Ignorable="d"
        Title="Aperture" Height="520" Width="420" MinHeight="460" MinWidth="360"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Name" Grid.Row="0" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Guid" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Guid" Grid.Row="1" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Construction" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Construction" Grid.Row="2" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Aperture Type" VerticalAlignment="Center"/>
            <ComboBox x:Name="ComboBox_ApertureType" Grid.Row="3" Grid.Column="1" IsEnabled="False" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Area" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Area" Grid.Row="4" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Azimuth" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Azimuth" Grid.Row="5" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>
        </Grid>

        <GroupBox Grid.Row="1" Header="Parameters" Margin="0,6,0,6">
            <wpf:ParametersControl x:Name="ParametersControl_Main"/>
        </GroupBox>

        <Grid Grid.Row="2">
            <Button x:Name="Button_SelectConstruction" Content="Select Construction" Width="150" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button_SelectConstruction_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="0,0,6,0" IsDefault="True" Click="Button_OK_Click"/>
                <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" IsCancel="True" Click="Button_Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

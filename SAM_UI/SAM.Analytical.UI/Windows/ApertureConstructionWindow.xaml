<Window x:Class="SAM.Analytical.UI.ApertureConstructionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Analytical.UI"
        mc:Ignorable="d"
        Title="Aperture Construction" Height="540" Width="760" MinHeight="520" MinWidth="600"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBox_Name" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,3"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBox_Description" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,3"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Aperture Type:" VerticalAlignment="Center"/>
        <ComboBox x:Name="ComboBox_ApertureType" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,3"/>

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Pane" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Frame" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:MaterialLayersControl x:Name="MaterialLayersControl_Pane" Grid.Column="0" Margin="0,0,3,0"/>
            <local:MaterialLayersControl x:Name="MaterialLayersControl_Frame" Grid.Column="1" Margin="3,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="0,0,6,0" IsDefault="True" Click="Button_OK_Click"/>
            <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" IsCancel="True" Click="Button_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

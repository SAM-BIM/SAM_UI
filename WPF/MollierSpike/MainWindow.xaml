<Window x:Class="MollierSpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Mollier OxyPlot Spike" Height="760" Width="1100">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Export PNG" Click="ExportPng_Click" Margin="2" />
            <Button Content="Export SVG" Click="ExportSvg_Click" Margin="2" />
            <Button Content="Export EMF" Click="ExportEmf_Click" Margin="2" />
            <Separator />
            <TextBlock Text="Click a red point to hit-test; drag to rubber-band select."
                       VerticalAlignment="Center" Margin="8,0" />
        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
        </StatusBar>
        <oxy:PlotView x:Name="PlotView"
                      MouseDown="PlotView_MouseDown"
                      MouseMove="PlotView_MouseMove"
                      MouseUp="PlotView_MouseUp" />
    </DockPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THROWAWAY spike (Stage 2a) — validates that OxyPlot.Wpf covers the WinForms
    System.Windows.Forms.DataVisualization.Chart capabilities the Mollier port relies on:
    hit-test, axis pixel<->value transforms, PNG/SVG export, EMF via Metafile bridge,
    and RectangleAnnotation drag-select. NOT shipped. Delete after the spike review gate.

    Key flag under test: UseWPF=true with UseWindowsForms=false — proves OxyPlot.WindowsForms'
    GraphicsRenderContext (EMF bridge) can be referenced WITHOUT pulling in WinForms,
    as the plan claims.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\</OutputPath>
    <!-- Spike is self-contained; do not let the repo version target inject anything odd. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="OxyPlot.WindowsForms" Version="2.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <!-- Smoke-test only: drive the ported 2c chart-builders against the real domain layer. -->
  <ItemGroup>
    <ProjectReference Include="..\SAM.Core.Mollier.UI.WPF\SAM.Core.Mollier.UI.WPF.csproj" />
    <Reference Include="SAM.Core.Mollier">
      <HintPath>..\..\..\SAM_Mollier\build\SAM.Core.Mollier.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>

<UserControl x:Class="SAM.Core.Mollier.UI.Controls.UIMollierProcessControl_Limited"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="253" Height="146"
             d:DesignHeight="146" d:DesignWidth="253"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <TextBlock x:Name="ProcessColor_Label" Text="Process color" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,11,0,0" />
        <Button x:Name="ProcessColor_button" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="143,11,0,0" Width="59" Height="23" Click="ProcessColor_button_Click" />
        <Button x:Name="Button_Clear" Content="c" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="208,11,0,0" Width="23" Height="23" Click="Button_Clear_Click" />

        <TextBlock x:Name="label4" Text="Start Label" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,41,0,0" />
        <TextBox x:Name="StartLabel_Value" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="143,43,0,0" Width="88" Height="22" VerticalContentAlignment="Center" />

        <TextBlock x:Name="label3" Text="Process Label" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,71,0,0" />
        <TextBox x:Name="ProcessLabel_Value" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="143,71,0,0" Width="88" Height="22" VerticalContentAlignment="Center" />

        <TextBlock x:Name="label2" Text="End Label" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,103,0,0" />
        <TextBox x:Name="EndLabel_Value" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="143,103,0,0" Width="88" Height="22" VerticalContentAlignment="Center" />
    </Grid>
</UserControl>

<UserControl x:Class="SAM.Core.Mollier.UI.Controls.BuiltInVisibilitySettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="613" Height="44"
             Loaded="BuiltInVisibilitySettingControl_Load"
             d:DesignHeight="44" d:DesignWidth="613"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <CheckBox x:Name="CheckBox_Visible" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,13,0,0" />
        <ComboBox x:Name="ComboBox_ChartParameterType" IsEditable="False" IsEnabled="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,9,0,0" Width="139" Height="24" />
        <ComboBox x:Name="ComboBox_ChartDataType" IsEditable="False" IsEnabled="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="179,9,0,0" Width="226" Height="24" />
        <Button x:Name="Button_Color" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="411,10,0,0" Width="177" Height="23" Click="Button_Color_Click" />
    </Grid>
</UserControl>

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="213" Height="60"
             d:DesignHeight="60" d:DesignWidth="213"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <TextBlock x:Name="Label_Color" Text="Color:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,6,0,0" />
        <Button x:Name="Button_Color" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="54,3,0,0" Width="147" Height="23" Click="Button_Color_Click" />
        <TextBlock x:Name="Label_Label" Text="Label:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,35,0,0" />
        <TextBox x:Name="TextBox_Label" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="54,32,0,0" Width="147" Height="22" VerticalContentAlignment="Center" />
    </Grid>
</UserControl>

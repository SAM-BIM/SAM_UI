        <TextBlock x:Name="label1" Text="Calculation Type" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,5,0,0" />
        <ComboBox x:Name="processCalculateType_ComboBox" IsEditable="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="244,30,0,0" Width="242" Height="24"

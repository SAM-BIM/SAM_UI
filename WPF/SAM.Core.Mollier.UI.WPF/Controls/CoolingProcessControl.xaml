        <TextBlock x:Name="label2" Text="Air Start Conditions" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,30,0,0" />
        <local:MollierPointControl x:Name="MollierPointControl_Start" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,53,0,0" Width="172" Height="220" Pressure="101325" />
        <StackPanel x:Name="flowLayoutPanel_Main" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="244,60,0,0" Width="373" Height="290" />
    </Grid>
</UserControl>

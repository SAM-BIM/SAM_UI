             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <TextBlock x:Name="label2" Text="Air Start Conditions" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,9,0,0" />
        <local:MollierPointControl x:Name="MollierPointControl_Start" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,32,0,0" Width="168" Height="220" Pressure="101325" />
        <local:ParameterControl x:Name="ParameterControl_HumidityRatio_Start" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,233,0,0" Width="168" Height="51" />

        <TextBlock x:Name="label1" Text="Room Data" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="254,9,0,0" />

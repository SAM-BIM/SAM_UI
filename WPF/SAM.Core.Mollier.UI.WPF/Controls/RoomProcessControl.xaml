        <local:ParameterControl x:Name="ParameterControl_SensibleLoad" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="227,99,0,0" Width="168" Height="51" />
        <local:ParameterControl x:Name="ParameterControl_LatentLoad" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="227,156,0,0" Width="168" Height="51" />
        <local:ParameterControl x:Name="ParameterControl_SensibleLoadRatio" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="227,212,0,0" Width="168" Height="51" />
        <local:ParameterControl x:Name="ParameterControl_Epsilon" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="227,269,0,0" Width="168" Height="51" />

        <TextBlock x:Name="label3" Text="Room Air Conditions" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="406,9,0,0" />
        <local:MollierPointControl x:Name="mollierPointControl_Room" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="401,32,0,0" Width="168" Height="220" Pressure="101325" />
        <local:ParameterControl x:Name="ParameterControl_HumidityRatio_Room" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="401,232,0,0" Width="168" Height="51" />

<UserControl x:Class="SAM.Core.Mollier.UI.Controls.UIMollierPointControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="242" Height="137"
             d:DesignHeight="137" d:DesignWidth="242"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <TextBlock x:Name="PointColor_Label" Text="Point color" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,12,0,0" />
        <Button x:Name="PointColor_Button" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,12,0,0" Width="59" Height="23" Click="PointColor_Button_Click" />
        <Button x:Name="Button_PointClear" Content="c" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="206,12,0,0" Width="23" Height="23" Click="Button_PointClear_Click" />

        <TextBlock x:Name="PointLabel_Label" Text="Point Label" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,42,0,0" />
        <TextBox x:Name="PointLabel_TextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,44,0,0" Width="88" Height="22" VerticalContentAlignment="Center" />

        <TextBlock x:Name="Label_LabelColor" Text="Label color" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,72,0,0" />
        <Button x:Name="LabelColor_Button" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,72,0,0" Width="59" Height="23" Click="LabelColor_Button_Click" />
        <Button x:Name="Button_LabelClear" Content="c" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="206,72,0,0" Width="23" Height="23" Click="Button_LabelClear_Click" />

        <TextBlock x:Name="Label_LabelLocation" Text="Label location" FontSize="13.333" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,101,0,0" />
        <Button x:Name="Button_LabelLocation" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,101,0,0" Width="59" Height="23" Click="Button_LabelLocation_Click" />
        <Button x:Name="Button_LabelLocationClear" Content="c" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="206,101,0,0" Width="23" Height="23" Click="Button_LabelLocationClear_Click" />
    </Grid>
</UserControl>

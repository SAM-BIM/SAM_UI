<Window x:Class="SAM.Core.Mollier.UI.Forms.UIMollierObjectsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit / Remove" Width="1539" Height="592" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ContextMenu x:Key="ContextMenuStrip_Main">
            <MenuItem Header="Edit" Click="ToolStripMenuItem_Edit_Click" />
            <MenuItem Header="Remove" Click="ToolStripMenuItem_Remove_Click" />
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <TabControl x:Name="customizeMollierObjectsTabControl">
            <!-- Points -->
            <TabItem Header="Points">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="PressurePoints_Label" Text="Pressure" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,20,0,0" />
                        <TextBox x:Name="PressurePoints_TextBox" Text="0" IsReadOnly="True" TextAlignment="Right" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="148,17,0,0" Width="68" Height="22" />
                        <TextBlock x:Name="label2" Text="Group" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="265,20,0,0" />
                        <ComboBox x:Name="GroupSelectionPoints_ComboBox" IsEditable="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="325,17,0,0" Width="129" Height="24"
                                  SelectionChanged="GroupSelectionPoints_ComboBox_SelectedValueChanged" />
                    </Grid>
                    <DataGrid x:Name="DataGridView_MollierPoints" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                              ContextMenu="{StaticResource ContextMenuStrip_Main}"
                              SelectionChanged="DataGridView_MollierPoints_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Visible" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Visible, Mode=OneWay}" HorizontalAlignment="Center"
                                                  Click="VisibleCheckBox_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="72" />
                            <DataGridTextColumn Header="Dry bulb temperature t [°C]" Binding="{Binding DryBulbTemperature}" Width="116" />
                            <DataGridTextColumn Header="Humidity ratio x [g/kg]" Binding="{Binding HumidityRatio}" Width="117" />
                            <DataGridTextColumn Header="Relative humidity φ [%]" Binding="{Binding RelativeHumidity}" Width="136" />
                            <DataGridTextColumn Header="Wet bulb temperature t_wb [°C]" Binding="{Binding WetBulbTemperature}" Width="159" />
                            <DataGridTextColumn Header="Dew point temperature t_tao [°C]" Binding="{Binding DewPointTemperature}" Width="141" />
                            <DataGridTextColumn Header="Specific volume v [m3/kg]" Binding="{Binding SpecificVolume}" Width="128" />
                            <DataGridTextColumn Header="Enthalpy h [kJ/kg*K]" Binding="{Binding Enthalpy}" Width="120" />
                            <DataGridTextColumn Header="Density p [kg/m3]" Binding="{Binding Density}" Width="92" />
                            <DataGridTemplateColumn Header="Edit" Width="38">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="..." Click="EditButton_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Remove" Width="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X" Click="RemoveButton_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!-- Processes -->
            <TabItem Header="Processes">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="PressureProcesses_Label" Text="Pressure" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,20,0,0" />
                        <TextBox x:Name="PressureProcesses_TextBox" Text="0" IsReadOnly="True" TextAlignment="Right" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="148,16,0,0" Width="68" Height="22" />
                        <TextBlock x:Name="label1" Text="Group" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="263,19,0,0" />
                        <ComboBox x:Name="GroupSelectionProcesses_ComboBox" IsEditable="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="323,16,0,0" Width="129" Height="24"
                                  SelectionChanged="GroupSelectionProcesses_ComboBox_SelectedValueChanged" />
                        <CheckBox x:Name="SupplyAirFlow_CheckBox" Content="Supply airflow" IsChecked="True" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="508,20,0,0"
                                  Click="SupplyAirFlow_CheckBox_CheckedChanged" />
                        <TextBox x:Name="SupplyAirFlow_TextBox" Text="0" TextAlignment="Right" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="646,18,0,0" Width="68" Height="22"
                                 TextChanged="SupplyAirFlow_TextBox_TextChanged" />
                        <ComboBox x:Name="SupplyAirflow_ComboBox" IsEditable="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="720,16,0,0" Width="61" Height="24"
                                  SelectionChanged="SupplyAirflow_ComboBox_SelectedIndexChanged">
                            <ComboBoxItem Content="m3/s" />
                            <ComboBoxItem Content="m3/h" />
                        </ComboBox>
                        <TextBox x:Name="ExhaustAirFlow_TextBox" Text="0" TextAlignment="Right" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="983,18,0,0" Width="68" Height="22" />
                        <CheckBox x:Name="ExhaustAirflow_CheckBox" Content="Exhaust airflow" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="835,20,0,0" />
                        <ComboBox x:Name="ExhaustAirflow_Combobox" IsEditable="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1057,16,0,0" Width="62" Height="24">
                            <ComboBoxItem Content="m3/s" />
                            <ComboBoxItem Content="m3/h" />
                        </ComboBox>
                    </Grid>
                    <DataGrid x:Name="DataGridView_MollierProcesses" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserResizeColumns="False"
                              HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                              ContextMenu="{StaticResource ContextMenuStrip_Main}"
                              SelectionChanged="DataGridView_MollierProcesses_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Visible" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Visible, Mode=OneWay}" HorizontalAlignment="Center"
                                                  Click="VisibleCheckBox_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="74" />
                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="72" />
                            <DataGridTextColumn Header="Dry bulb temperature t [°C]" Binding="{Binding DryBulbTemperature}" Width="116" />
                            <DataGridTextColumn Header="Humidity ratio x [g/kg]" Binding="{Binding HumidityRatio}" Width="117" />
                            <DataGridTextColumn Header="Relative humidity φ [%]" Binding="{Binding RelativeHumidity}" Width="136" />
                            <DataGridTextColumn Header="Wet bulb temperature t_wb [°C]" Binding="{Binding WetBulbTemperature}" Width="159" />
                            <DataGridTextColumn Header="Dew point temperature t_tao [°C]" Binding="{Binding DewPointTemperature}" Width="141" />
                            <DataGridTextColumn Header="Specific volume v [m3/kg]" Binding="{Binding SpecificVolume}" Width="128" />
                            <DataGridTextColumn Header="Enthalpy h [kJ/kg*K]" Binding="{Binding Enthalpy}" Width="120" />
                            <DataGridTextColumn Header="Density p [kg/m3]" Binding="{Binding Density}" Width="92" />
                            <DataGridTextColumn Header="Mass flow m [kg/s]" Binding="{Binding MassFlow}" Width="91" />
                            <DataGridTextColumn Header="Total Load Qtot [kW]" Binding="{Binding TotalLoad}" Width="101" />
                            <DataGridTextColumn Header="Sensible Load Qsens [kW]" Binding="{Binding SensibleLoad}" Width="120" />
                            <DataGridTextColumn Header="Latent Load Qlat [kW]" Binding="{Binding LatentLoad}" Width="95" />
                            <DataGridTemplateColumn Header="Edit" Width="61">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="..." Click="EditButton_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Remove" Width="89">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X" Click="RemoveButton_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

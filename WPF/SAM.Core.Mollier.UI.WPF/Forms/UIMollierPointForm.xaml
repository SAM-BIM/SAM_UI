<Window x:Class="SAM.Core.Mollier.UI.Forms.UIMollierPointForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SAM.Core.Mollier.UI.Controls"
        Title="Edit Mollier Point" Width="360" Height="243"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="CustomizePointForm_Load">
    <Grid>
        <controls:UIMollierPointControl x:Name="CustomizePointControl_Main" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" Width="320" Height="132" />
        <Button x:Name="Button_Apply" Content="Apply" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,165,0,0" Width="102" Height="31" Click="Button_Apply_Click" />
        <Button x:Name="OK_Button" Content="OK" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="126,165,0,0" Width="102" Height="31" Click="OK_Button_Click" />
        <Button x:Name="Cancel_Button" Content="Cancel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="234,165,0,0" Width="102" Height="31" Click="Cancel_Button_Click" />
    </Grid>
</Window>

<Window x:Class="SAM.Weather.UI.WPF.WeatherDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:wpf="clr-namespace:SAM.Core.UI.WPF;assembly=SAM.Core.UI.WPF"
        mc:Ignorable="d"
        Title="Weather Data" Height="760" Width="1080" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="33"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Top: identity + parameters (left) | values grid (right) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                    <TextBox x:Name="TextBox_Name" Grid.Row="0" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Guid" VerticalAlignment="Center"/>
                    <TextBox x:Name="TextBox_Guid" Grid.Row="1" Grid.Column="1" IsReadOnly="True" TabIndex="100" VerticalAlignment="Center" Margin="0,2"/>

                    <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="Parameters" Margin="0,6,0,0">
                        <wpf:ParametersControl x:Name="ParametersControl_Main"/>
                    </GroupBox>
                </Grid>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <DataGrid x:Name="DataGrid_Main" Grid.Column="2" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          SelectionUnit="FullRow" GridLinesVisibility="All"/>
            </Grid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Bottom: one chart tab per weather data type -->
            <TabControl x:Name="TabControl_Main" Grid.Row="2"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click"/>
            <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" Margin="5,0,0,0" IsCancel="True" Click="Button_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="SAM.Core.UI.WPF.MaterialLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Core.UI.WPF"
        mc:Ignorable="d"
        Title="Material Library" Height="520" Width="640" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
            <TextBlock Text="Search" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TextBox_Search" VerticalAlignment="Center" TextChanged="TextBox_Search_TextChanged"/>
        </DockPanel>

        <DataGrid x:Name="DataGrid_Materials" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  MouseDoubleClick="DataGrid_Materials_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                <DataGridTextColumn Header="Material Type" Binding="{Binding MaterialType}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="Button_Add" Content="Add" Width="70" Height="26" Margin="0,0,5,0" Click="Button_Add_Click"/>
            <Button x:Name="Button_Remove" Content="Remove" Width="70" Height="26" Margin="0,0,5,0" Click="Button_Remove_Click"/>
            <Button x:Name="Button_Duplicate" Content="Duplicate" Width="70" Height="26" Margin="0,0,5,0" Click="Button_Duplicate_Click"/>
            <Button x:Name="Button_Import" Content="Import" Width="70" Height="26" Margin="0,0,5,0" Click="Button_Import_Click"/>
            <Button x:Name="Button_Export" Content="Export" Width="70" Height="26" Margin="0,0,5,0" Click="Button_Export_Click"/>
            <Button x:Name="Button_OK" Content="OK" Width="75" Height="26" Margin="20,0,5,0" IsDefault="True" Click="Button_OK_Click"/>
            <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="26" IsCancel="True" Click="Button_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="SAM.Core.UI.WPF.JsonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Core.UI.WPF"
        mc:Ignorable="d"
        Title="JSON" Height="520" Width="640" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <local:JsonControl x:Name="JsonControl_Main" Grid.Row="0"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="Button_Save" Content="Save" Width="75" Height="26" Margin="0,0,5,0" Click="Button_Save_Click"/>
            <Button x:Name="Button_Copy" Content="Copy" Width="75" Height="26" Margin="0,0,5,0" Click="Button_Copy_Click"/>
            <Button x:Name="Button_Close" Content="Close" Width="75" Height="26" IsDefault="True" IsCancel="True" Click="Button_Close_Click"/>
        </StackPanel>
    </Grid>
</Window>

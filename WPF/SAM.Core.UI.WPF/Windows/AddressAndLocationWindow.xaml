<Window x:Class="SAM.Core.UI.WPF.AddressAndLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Core.UI.WPF"
        mc:Ignorable="d"
        Title="Address And Location" Height="360" Width="340" ResizeMode="NoResize" WindowStyle="SingleBorderWindow" ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="33"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Address" Margin="0,0,0,6">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Street" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_Street" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="City" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_City" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Postal Code" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_PostalCode" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Country" VerticalAlignment="Center"/>
                <ComboBox x:Name="ComboBox_Country" Grid.Row="3" Grid.Column="1" IsEditable="True" VerticalAlignment="Center" Margin="0,2"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Location" Margin="0,0,0,6">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Longitude" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_Longitude" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Latitude" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_Latitude" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Elevation" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_Elevation" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click"/>
            <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" Margin="5,0,0,0" IsCancel="True" Click="Button_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

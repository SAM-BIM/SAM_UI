<Window x:Class="SAM.Core.UI.WPF.MaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Core.UI.WPF"
        mc:Ignorable="d"
        Title="Material" Height="520" Width="380" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="33"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Name" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Display Name" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_DisplayName" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Description" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Description" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Material Type" VerticalAlignment="Center"/>
            <ComboBox x:Name="ComboBox_MaterialType" Grid.Row="3" Grid.Column="1" IsEnabled="False" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Thermal Conductivity" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_ThermalConductivity" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" PreviewTextInput="NumberOnly_PreviewTextInput"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Specific Heat Capacity" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_SpecificHeatCapacity" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" PreviewTextInput="NumberOnly_PreviewTextInput"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Density" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Density" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" PreviewTextInput="NumberOnly_PreviewTextInput"/>
        </Grid>

        <GroupBox Grid.Row="1" Header="Parameters" Margin="0,6,0,6">
            <local:ParametersControl x:Name="ParametersControl_Main"/>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click"/>
            <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" Margin="5,0,0,0" IsCancel="True" Click="Button_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

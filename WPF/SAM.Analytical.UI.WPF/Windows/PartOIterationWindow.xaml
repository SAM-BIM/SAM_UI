<Window x:Class="SAM.Analytical.UI.WPF.PartOIterationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Analytical.UI.WPF"
        mc:Ignorable="d"
        Title="Prepare Part O Iteration" Height="580" Width="620" ResizeMode="NoResize" FontFamily="Roboto Light">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Base provision" Padding="0,0,0,2"/>
        <ComboBox x:Name="comboBox_BaseProvision" Grid.Row="1" Height="22" HorizontalAlignment="Stretch"/>

        <!-- The route is not shown as an editable field. It is the canonical word the selected base
             provision is defined over, and it is the only vocabulary this window can produce. -->
        <TextBlock x:Name="textBlock_VentilationStrategy" Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555555"/>

        <Label Grid.Row="3" Content="Dwellings in scope" Margin="0,10,0,0" Padding="0,0,0,2"/>
        <ListBox x:Name="listBox_Zones" Grid.Row="4" MinHeight="120"/>

        <TextBlock x:Name="textBlock_Scope" Grid.Row="5" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555555"/>

        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <CheckBox x:Name="checkBox_SelectVentilationUnit" Content="Select a ventilation unit from the manufacturer catalogue (Iteration 2)"/>
            <TextBlock x:Name="textBlock_Catalogue" Margin="20,4,0,0" TextWrapping="Wrap" Foreground="#555555"/>

            <!-- Iteration 2B is deliberately NOT an entry in the base-provision list above. It is not a base
                 provision: it is an optimisation performed ON an Iteration 2 design, and it needs a selected
                 ventilation unit to work within - which is why it is offered here, under the selection tick
                 it depends on, and disabled without it. -->
            <CheckBox x:Name="checkBox_Optimise" Content="Automatically optimise TM59 failures (Iteration 2B)" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                <TextBlock Text="Airflow step [l/s]" VerticalAlignment="Center" Width="120"/>
                <TextBox x:Name="textBox_AirFlowStep" Width="60" Height="20" VerticalContentAlignment="Center"/>
                <TextBlock Text="Maximum iterations" VerticalAlignment="Center" Width="130" Margin="20,0,0,0"/>
                <TextBox x:Name="textBox_MaximumIterations" Width="60" Height="20" VerticalContentAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="textBlock_Optimise" Margin="20,4,0,0" TextWrapping="Wrap" Foreground="#555555"/>

            <!-- The capacity envelope is a DIAGNOSTIC and not a further optimisation step, which is why it
                 is a separate tick under 2B rather than another number beside the step and the limit. It
                 costs one more full-year TAS run, and only on a run that stops short of a pass. -->
            <CheckBox x:Name="checkBox_CapacityEnvelope" Content="Also report what the selected unit could deliver at its capacity ceiling (diagnostic)" Margin="20,8,0,0"/>
            <TextBlock x:Name="textBlock_CapacityEnvelope" Margin="40,4,0,0" TextWrapping="Wrap" Foreground="#555555"/>

            <!-- A workflow optimisation, not an engineering choice - which is why it is worded as reusing the
                 conversion rather than as anything about the simulation. Offered as a tick because the full
                 conversion has to stay available as the reference path. -->
            <CheckBox x:Name="checkBox_WarmStart" Content="Reuse the converted geometry between iterations (faster; no change to results)" Margin="20,8,0,0"/>
            <TextBlock x:Name="textBlock_WarmStart" Margin="40,4,0,10" TextWrapping="Wrap" Foreground="#555555"/>
        </StackPanel>

        <Button x:Name="button_OK" Grid.Row="7" Width="60" Height="20" Margin="0,6,80,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="button_OK_Click">OK</Button>
        <Button x:Name="button_Cancel" IsCancel="True" Grid.Row="7" Width="60" Height="20" Margin="0,6,10,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="button_Cancel_Click">Cancel</Button>
    </Grid>
</Window>

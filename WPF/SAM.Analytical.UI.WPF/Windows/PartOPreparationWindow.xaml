<Window x:Class="SAM.Analytical.UI.WPF.PartOPreparationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Analytical.UI.WPF"
        mc:Ignorable="d"
        Title="Part O Iteration" Height="700" Width="1140" FontFamily="Roboto Light">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="textBlock_Summary" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- CONVERT TO MANUAL sits with the assignments rather than in the previous dialog, because this is
             the first point at which the automatic answer exists to be converted. It is a change of
             SELECTION AUTHORITY and not a recalculation: every dwelling keeps the exact product it has. -->
        <Grid Grid.Row="1">
            <Label Content="Dwelling assignments - design duty and equipment capacity are different quantities" Padding="0,0,0,2" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="textBlock_Mode" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#555555"/>
                <Button x:Name="button_ConvertToManual" Content="Convert to Manual" Width="130" Height="22" Click="button_ConvertToManual_Click"
                        ToolTip="Keep every dwelling's current product exactly as it is, and take over the choice from here. Nothing is reselected and no airflow changes."/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="dataGrid_Equipment" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" MinHeight="90" SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="dataGrid_Equipment_SelectionChanged" CellEditEnding="dataGrid_Equipment_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dwelling" Binding="{Binding Dwelling}" Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="80" IsReadOnly="True"/>
                <!-- Design duty and Maximum capacity are deliberately in separate, differently headed
                     columns. A dwelling designed at 30 l/s that is fitted with a 150 l/s unit is a 30 l/s
                     dwelling. -->
                <DataGridTextColumn Header="Design supply&#x0a;l/s" Binding="{Binding DesignSupplyDuty_Lps, StringFormat=N1}" Width="85" IsReadOnly="True"/>
                <DataGridTextColumn Header="Design extract&#x0a;l/s" Binding="{Binding DesignExtractDuty_Lps, StringFormat=N1}" Width="85" IsReadOnly="True"/>

                <!-- The one editable cell, and only in manual mode - the grid itself is read-only in the
                     automatic modes, where these rows are results rather than choices. The picker's list is
                     the project's permitted pool plus this dwelling's own product where that has since left
                     the pool, so a procurement change can never make an authored assignment unpickable. -->
                <DataGridTemplateColumn Header="Assigned product" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedProduct}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Maximum supply&#x0a;l/s" Binding="{Binding MaximumSupply_Lps, StringFormat=N1}" Width="95" IsReadOnly="True"/>
                <DataGridTextColumn Header="Maximum extract&#x0a;l/s" Binding="{Binding MaximumExtract_Lps, StringFormat=N1}" Width="95" IsReadOnly="True"/>
                <DataGridTextColumn Header="Supply headroom&#x0a;l/s" Binding="{Binding SupplyHeadroom_Lps, StringFormat=N1}" Width="95" IsReadOnly="True"/>
                <DataGridTextColumn Header="Extract headroom&#x0a;l/s" Binding="{Binding ExtractHeadroom_Lps, StringFormat=N1}" Width="95" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding SelectionOutcome}" Width="105" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- The selected row in words, and the ONLY way a suggestion is ever applied. A suggestion is
             offered here and taken by clicking; nothing is substituted because a suggestion exists. -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <TextBlock x:Name="textBlock_Assignment" TextWrapping="Wrap" Foreground="#555555" Margin="0,0,150,0"/>
            <Button x:Name="button_AssignSuggested" Content="Assign suggested" Width="130" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                    IsEnabled="False" Click="button_AssignSuggested_Click"
                    ToolTip="Assign the smallest permitted product that can meet this dwelling's design duty. Changes this dwelling only, and changes no airflow."/>
        </Grid>

        <Label Grid.Row="4" Content="Spaces - Approved Document F requirement and design airflow are different quantities" Margin="0,10,0,0" Padding="0,0,0,2" FontWeight="Bold"/>
        <DataGrid x:Name="dataGrid_Spaces" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="90">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Space" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="Part F required&#x0a;l/s" Binding="{Binding PartFRequired_Lps, StringFormat=N1}" Width="100"/>
                <DataGridTextColumn Header="Design supply&#x0a;l/s" Binding="{Binding DesignSupply_Lps, StringFormat=N1}" Width="100"/>
                <DataGridTextColumn Header="Design extract&#x0a;l/s" Binding="{Binding DesignExtract_Lps, StringFormat=N1}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Label Grid.Row="6" Content="Notes, warnings and refusals" Margin="0,10,0,0" Padding="0,0,0,2" FontWeight="Bold"/>
        <TextBox x:Name="textBox_Notes" Grid.Row="7" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"/>

        <Button x:Name="button_CopyAll" Grid.Row="8" Width="70" Height="20" Margin="0,6,150,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="button_CopyAll_Click">Copy All</Button>
        <Button x:Name="button_OK" Grid.Row="8" Width="60" Height="20" Margin="0,6,80,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="button_OK_Click">OK</Button>
        <Button x:Name="button_Cancel" IsCancel="True" Grid.Row="8" Width="60" Height="20" Margin="0,6,10,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="button_Cancel_Click">Cancel</Button>
    </Grid>
</Window>

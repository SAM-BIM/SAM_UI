<Window x:Class="SAM.Analytical.UI.WPF.SpaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Analytical.UI.WPF"
        xmlns:wpf="clr-namespace:SAM.Core.UI.WPF;assembly=SAM.Core.UI.WPF"
        mc:Ignorable="d"
        Title="Space" Height="540" Width="440" MinHeight="460" MinWidth="380"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Name" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Guid" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Guid" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Internal Condition" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_InternalCondition" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="Button_ModifyInternalCondition" Content="Modify Internal Condition" Width="170" Height="26" Margin="0,0,6,0" Click="Button_ModifyInternalCondition_Click"/>
                <Button x:Name="Button_RemoveInternalCondition" Content="Remove" Width="80" Height="26" Margin="0,0,6,0" Click="Button_RemoveInternalCondition_Click"/>
                <Button x:Name="Button_Occupancy" Content="Occupancy" Width="90" Height="26" Click="Button_Occupancy_Click"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="1" Header="Parameters" Margin="0,6,0,6">
            <wpf:ParametersControl x:Name="ParametersControl_Main"/>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="0,0,6,0" IsDefault="True" Click="Button_OK_Click"/>
            <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" IsCancel="True" Click="Button_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="SAM.Analytical.UI.WPF.OccupancyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Analytical.UI.WPF"
        mc:Ignorable="d"
        Title="Occupancy" Height="240" Width="360" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="60"/>
        </Grid.ColumnDefinitions>

        <CheckBox x:Name="CheckBox_InternalCondition" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="Use Internal Condition" VerticalAlignment="Center" Checked="CheckBox_InternalCondition_CheckedChanged" Unchecked="CheckBox_InternalCondition_CheckedChanged"/>

        <TextBlock x:Name="Label_AreaPerPerson" Grid.Row="1" Grid.Column="0" Text="Area Per Person" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBox_AreaPerPerson" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="TextBox_AreaPerPerson_TextChanged"/>
        <TextBlock x:Name="Label_AreaPerPerson_Unit" Grid.Row="1" Grid.Column="2" Text="m²/person" VerticalAlignment="Center" Margin="4,0,0,0"/>

        <TextBlock x:Name="Label_Occupancy" Grid.Row="2" Grid.Column="0" Text="Occupancy" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBox_Occupancy" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" PreviewTextInput="NumberOnly_PreviewTextInput" TextChanged="TextBox_Occupancy_TextChanged"/>
        <TextBlock x:Name="Label_Occupancy_Unit" Grid.Row="2" Grid.Column="2" Text="people" VerticalAlignment="Center" Margin="4,0,0,0"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Calculated Occupancy" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBox_CalculatedOccupancy" Grid.Row="3" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="people" VerticalAlignment="Center" Margin="4,0,0,0"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="0,0,6,0" IsDefault="True" Click="Button_OK_Click"/>
            <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" IsCancel="True" Click="Button_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

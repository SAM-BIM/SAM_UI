<Window x:Class="SAM.Analytical.UI.WPF.InternalConditionLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Internal Condition Library" Height="560" Width="560" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" KeyDown="Window_KeyDown">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Search" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBox_Search" Grid.Column="1" VerticalAlignment="Center" TextChanged="TextBox_Search_TextChanged"/>
        </Grid>

        <DataGrid x:Name="DataGrid_InternalConditions" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="All"
                  MouseDoubleClick="DataGrid_InternalConditions_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="Button_Add" Content="Add" Width="70" Height="28" Margin="0,0,6,0" Click="Button_Add_Click"/>
                <Button x:Name="Button_Duplicate" Content="Duplicate" Width="70" Height="28" Margin="0,0,6,0" Click="Button_Duplicate_Click"/>
                <Button x:Name="Button_Remove" Content="Remove" Width="70" Height="28" Margin="0,0,6,0" Click="Button_Remove_Click"/>
                <Button x:Name="Button_Import" Content="Import" Width="70" Height="28" Margin="0,0,6,0" Click="Button_Import_Click"/>
                <Button x:Name="Button_Export" Content="Export" Width="70" Height="28" Click="Button_Export_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click"/>
                <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" Margin="5,0,0,0" IsCancel="True" Click="Button_Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

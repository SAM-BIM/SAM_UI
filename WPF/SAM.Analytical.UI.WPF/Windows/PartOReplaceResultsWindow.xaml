<Window x:Class="SAM.Analytical.UI.WPF.PartOReplaceResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Part O — Replace existing results" Width="640" SizeToContent="Height" MinWidth="480"
        ResizeMode="NoResize" FontFamily="Roboto Light" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SAM.Analytical.UI.WPF;component/Themes/PartOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- One decision: replace the generated files of THIS case in THIS folder, or cancel. Nothing is deleted until
         Replace is pressed; Cancel is the default and Escape. -->
    <StackPanel Margin="16,14,16,14">
        <TextBlock x:Name="textBlock_Heading" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>

        <TextBlock Style="{StaticResource PartO.Caption}" Margin="0,10,0,2" Text="Folder"/>
        <TextBox x:Name="textBox_Folder" IsReadOnly="True" Padding="4,3" TextWrapping="Wrap" Background="#F5F5F5"/>

        <TextBlock x:Name="textBlock_Contents" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <TextBlock x:Name="textBlock_Explanation" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="button_Replace" Content="Replace existing results" MinWidth="170" Height="28" Padding="12,0" Margin="0,0,8,0"/>
            <Button x:Name="button_Cancel" Content="Cancel" MinWidth="90" Height="28" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="SAM.Analytical.UI.WPF.EngineComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare Tas / OpenStudio" Height="780" Width="1180" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner">
    <!-- SAM_UI#231, Phase 1: a lightweight view over SAM_Validation's comparison of two B1a documents. Every value, difference,
         band and note shown is SAM_Validation's; this window only lays them out. No charts in Phase 1. -->
    <Window.Resources>
        <Style x:Key="Style_Row" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="NotEquivalent">
                    <Setter Property="Foreground" Value="#6A6A6A"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="MissingOnTas">
                    <Setter Property="Background" Value="#FFF6D8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="MissingOnOpenStudio">
                    <Setter Property="Background" Value="#FFF6D8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unavailable">
                    <Setter Property="Background" Value="#EFEFEF"/>
                    <Setter Property="Foreground" Value="#6A6A6A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInformational}" Value="True">
                    <Setter Property="Background" Value="#F4F4F4"/>
                    <Setter Property="Foreground" Value="#6A6A6A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnitMismatch}" Value="True">
                    <Setter Property="Background" Value="#F4F4F4"/>
                    <Setter Property="Foreground" Value="#6A6A6A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Band colouring applies to compared rows only: a not-equivalent or missing metric is never styled as a pass or a fail. -->
        <Style x:Key="Style_BandCell" TargetType="DataGridCell">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Compared"/>
                        <Condition Binding="{Binding Band}" Value="Match"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#DFF2DF"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Compared"/>
                        <Condition Binding="{Binding Band}" Value="Warn"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FCEBC7"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Compared"/>
                        <Condition Binding="{Binding Band}" Value="Fail"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F6D2D2"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Style_NumericCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Style_NumericHeader" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Style_TasCell" TargetType="TextBlock" BasedOn="{StaticResource Style_NumericCell}">
            <Setter Property="ToolTip" Value="{Binding TasFull}"/>
        </Style>
        <Style x:Key="Style_OpenStudioCell" TargetType="TextBlock" BasedOn="{StaticResource Style_NumericCell}">
            <Setter Property="ToolTip" Value="{Binding OpenStudioFull}"/>
        </Style>
        <Style x:Key="Style_AbsDifferenceCell" TargetType="TextBlock" BasedOn="{StaticResource Style_NumericCell}">
            <Setter Property="ToolTip" Value="{Binding AbsoluteDifferenceFull}"/>
        </Style>
        <Style x:Key="Style_PercentCell" TargetType="TextBlock" BasedOn="{StaticResource Style_NumericCell}">
            <Setter Property="ToolTip" Value="{Binding PercentDifferenceFull}"/>
        </Style>
        <Style x:Key="Style_NoteCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="ToolTip" Value="{Binding Note}"/>
        </Style>
        <!-- Text columns keep their full value available when a fixed, readable column width clips it. -->
        <Style x:Key="Style_MetricCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Metric}"/>
        </Style>
        <Style x:Key="Style_StatusCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding StatusText}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Runs (B1a documents)" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tas:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox x:Name="TextBox_Tas" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,0,6,4"/>
                <Button x:Name="Button_BrowseTas" Grid.Row="0" Grid.Column="2" Content="Browse..." Width="90" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="OpenStudio:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox x:Name="TextBox_OpenStudio" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,6,4"/>
                <Button x:Name="Button_BrowseOpenStudio" Grid.Row="1" Grid.Column="2" Content="Browse..." Width="90" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="Button_Run" Content="Run Tas + OpenStudio..." Padding="10,3" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True"/>
                    <Button x:Name="Button_LoadFolder" Content="Load run folder..." Padding="10,3" Margin="0,0,8,0"/>
                    <Button x:Name="Button_Compare" Content="Compare" Padding="10,3"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Border x:Name="Border_Banner" Grid.Row="1" Margin="0,8,0,8" Padding="8,6" Background="#F2F2F2">
            <TextBlock x:Name="TextBlock_Banner" TextWrapping="Wrap" Text="Choose a Tas and an OpenStudio B1a document, load a comparison run folder, or run both engines on the open model."/>
        </Border>

        <TabControl x:Name="TabControl_Main" Grid.Row="2">
            <TabItem Header="Model">
                <!-- The grid owns its scrolling. Fixed, readable pixel widths (including Note) keep every column legible at a
                     narrow window; the grid then scrolls horizontally instead of compressing the columns. A star column would
                     let WPF shrink all columns to fit the viewport, which made the 820 px layout unreadable. -->
                <DataGrid x:Name="DataGrid_Model" AutoGenerateColumns="False" IsReadOnly="True" RowStyle="{StaticResource Style_Row}" HeadersVisibility="Column" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="160" ElementStyle="{StaticResource Style_MetricCell}"/>
                        <!-- Wide enough for the longest unit token (hourOfYear). -->
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="85"/>
                        <DataGridTextColumn Header="Tas" Binding="{Binding Tas}" Width="80" ElementStyle="{StaticResource Style_TasCell}" HeaderStyle="{StaticResource Style_NumericHeader}"/>
                        <DataGridTextColumn Header="OpenStudio" Binding="{Binding OpenStudio}" Width="90" ElementStyle="{StaticResource Style_OpenStudioCell}" HeaderStyle="{StaticResource Style_NumericHeader}"/>
                        <DataGridTextColumn Header="Abs. difference" Binding="{Binding AbsoluteDifference}" Width="100" ElementStyle="{StaticResource Style_AbsDifferenceCell}" HeaderStyle="{StaticResource Style_NumericHeader}"/>
                        <DataGridTextColumn Binding="{Binding PercentDifference}" Width="135" ElementStyle="{StaticResource Style_PercentCell}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Normalized difference (%)" TextWrapping="Wrap" TextAlignment="Center" Width="120"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="55" CellStyle="{StaticResource Style_BandCell}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="140" ElementStyle="{StaticResource Style_StatusCell}"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="275" ElementStyle="{StaticResource Style_NoteCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Spaces">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Space:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ComboBox_Space" MinWidth="320"/>
                    </StackPanel>
                    <!-- Same sizing rule as the Model grid: fixed readable widths, Note included, and the grid scrolls horizontally. -->
                    <DataGrid x:Name="DataGrid_Spaces" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" RowStyle="{StaticResource Style_Row}" HeadersVisibility="Column" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy full GUID" Click="CopyGuid_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Space" Binding="{Binding SpaceName}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="ToolTip" Value="{Binding SpaceName}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="GUID" Binding="{Binding ScopeDisplay}" Width="80">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="#222222"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#222222"/>
                                        <Setter Property="ToolTip" Value="{Binding ScopeFull}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="125" ElementStyle="{StaticResource Style_MetricCell}"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="85"/>
                            <DataGridTextColumn Header="Tas" Binding="{Binding Tas}" Width="60" ElementStyle="{StaticResource Style_TasCell}" HeaderStyle="{StaticResource Style_NumericHeader}"/>
                            <DataGridTextColumn Header="OpenStudio" Binding="{Binding OpenStudio}" Width="75" ElementStyle="{StaticResource Style_OpenStudioCell}" HeaderStyle="{StaticResource Style_NumericHeader}"/>
                            <DataGridTextColumn Header="Abs. difference" Binding="{Binding AbsoluteDifference}" Width="90" ElementStyle="{StaticResource Style_AbsDifferenceCell}" HeaderStyle="{StaticResource Style_NumericHeader}"/>
                            <DataGridTextColumn Binding="{Binding PercentDifference}" Width="140" ElementStyle="{StaticResource Style_PercentCell}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Normalized difference (%)" TextWrapping="Wrap" TextAlignment="Right" Width="128"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="45" CellStyle="{StaticResource Style_BandCell}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="140" ElementStyle="{StaticResource Style_StatusCell}"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="160" ElementStyle="{StaticResource Style_NoteCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Provenance">
                <TextBox x:Name="TextBox_Provenance" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap"/>
            </TabItem>
            <TabItem Header="Diagnostics">
                <TextBox x:Name="TextBox_Diagnostics" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap"/>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock TextWrapping="Wrap" Foreground="#6A6A6A"
                           Text="Normalized difference (%) = 100 × |OpenStudio − TAS| / max(|TAS|, |OpenStudio|, applicable near-zero floor). It is unsigned and is not percentage change against TAS; peak hours use circular hours and no percentage. Bands are provisional tolerance bands, not engineering verdicts."/>
                <TextBlock TextWrapping="Wrap" Foreground="#6A6A6A" Margin="0,3,0,0"
                           Text="Values, differences, bands and notes are SAM_Validation's (benchmark-compare). Missing values are never shown as zero. Unit mismatches and informational rows are labelled; informational rows keep their band but are excluded from the numerical status."/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="Button_OpenReport" Content="Open report" Padding="10,3" Margin="6,0,0,0" IsEnabled="False"/>
                <Button x:Name="Button_Export" Content="Export reports..." Padding="10,3" Margin="6,0,0,0" IsEnabled="False"/>
                <Button x:Name="Button_OpenFolder" Content="Open run folder" Padding="10,3" Margin="6,0,0,0" IsEnabled="False"/>
                <Button x:Name="Button_Close" Content="Close" Padding="10,3" Margin="6,0,0,0" IsCancel="True"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="SAM.Analytical.UI.WPF.EngineComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare Tas / OpenStudio" Height="780" Width="1180" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner">
    <!-- SAM_UI#231, Phase 1: a lightweight view over SAM_Validation's comparison of two B1a documents. Every value, difference,
         band and note shown is SAM_Validation's; this window only lays them out. No charts in Phase 1. -->
    <Window.Resources>
        <Style x:Key="Style_Row" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="NotEquivalent">
                    <Setter Property="Foreground" Value="#6A6A6A"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="MissingOnTas">
                    <Setter Property="Background" Value="#FFF6D8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="MissingOnOpenStudio">
                    <Setter Property="Background" Value="#FFF6D8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unavailable">
                    <Setter Property="Background" Value="#EFEFEF"/>
                    <Setter Property="Foreground" Value="#6A6A6A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Band colouring applies to compared rows only: a not-equivalent or missing metric is never styled as a pass or a fail. -->
        <Style x:Key="Style_BandCell" TargetType="DataGridCell">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Compared"/>
                        <Condition Binding="{Binding Band}" Value="Match"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#DFF2DF"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Compared"/>
                        <Condition Binding="{Binding Band}" Value="Warn"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FCEBC7"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Compared"/>
                        <Condition Binding="{Binding Band}" Value="Fail"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F6D2D2"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Runs (B1a documents)" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tas:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox x:Name="TextBox_Tas" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,0,6,4"/>
                <Button x:Name="Button_BrowseTas" Grid.Row="0" Grid.Column="2" Content="Browse..." Width="90" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="OpenStudio:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <TextBox x:Name="TextBox_OpenStudio" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,6,4"/>
                <Button x:Name="Button_BrowseOpenStudio" Grid.Row="1" Grid.Column="2" Content="Browse..." Width="90" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="Button_Run" Content="Run Tas + OpenStudio..." Padding="10,3" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True"/>
                    <Button x:Name="Button_LoadFolder" Content="Load run folder..." Padding="10,3" Margin="0,0,8,0"/>
                    <Button x:Name="Button_Compare" Content="Compare" Padding="10,3"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Border x:Name="Border_Banner" Grid.Row="1" Margin="0,8,0,8" Padding="8,6" Background="#F2F2F2">
            <TextBlock x:Name="TextBlock_Banner" TextWrapping="Wrap" Text="Choose a Tas and an OpenStudio B1a document, load a comparison run folder, or run both engines on the open model."/>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Model">
                <DataGrid x:Name="DataGrid_Model" AutoGenerateColumns="False" IsReadOnly="True" RowStyle="{StaticResource Style_Row}" HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Metric" Binding="{Binding Metric}"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}"/>
                        <DataGridTextColumn Header="Tas" Binding="{Binding Tas}"/>
                        <DataGridTextColumn Header="OpenStudio" Binding="{Binding OpenStudio}"/>
                        <DataGridTextColumn Header="Abs. difference" Binding="{Binding AbsoluteDifference}"/>
                        <DataGridTextColumn Header="Difference %" Binding="{Binding PercentDifference}"/>
                        <DataGridTextColumn Header="Band" Binding="{Binding Band}" CellStyle="{StaticResource Style_BandCell}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Spaces">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Space:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ComboBox_Space" MinWidth="320"/>
                    </StackPanel>
                    <DataGrid x:Name="DataGrid_Spaces" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" RowStyle="{StaticResource Style_Row}" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Space" Binding="{Binding SpaceName}"/>
                            <DataGridTextColumn Header="GUID" Binding="{Binding Scope}"/>
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}"/>
                            <DataGridTextColumn Header="Tas" Binding="{Binding Tas}"/>
                            <DataGridTextColumn Header="OpenStudio" Binding="{Binding OpenStudio}"/>
                            <DataGridTextColumn Header="Abs. difference" Binding="{Binding AbsoluteDifference}"/>
                            <DataGridTextColumn Header="Difference %" Binding="{Binding PercentDifference}"/>
                            <DataGridTextColumn Header="Band" Binding="{Binding Band}" CellStyle="{StaticResource Style_BandCell}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Provenance">
                <TextBox x:Name="TextBox_Provenance" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </TabItem>
            <TabItem Header="Diagnostics">
                <TextBox x:Name="TextBox_Diagnostics" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="Button_OpenReport" Content="Open report" Padding="10,3" Margin="8,0,0,0" IsEnabled="False"/>
                <Button x:Name="Button_Export" Content="Export reports..." Padding="10,3" Margin="8,0,0,0" IsEnabled="False"/>
                <Button x:Name="Button_OpenFolder" Content="Open run folder" Padding="10,3" Margin="8,0,0,0" IsEnabled="False"/>
                <Button x:Name="Button_Close" Content="Close" Padding="10,3" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#6A6A6A" VerticalAlignment="Center"
                       Text="Values, differences, bands and notes are SAM_Validation's (benchmark-compare). A band is a tolerance band, not an engineering verdict; missing and not-equivalent metrics are never shown as zero."/>
        </DockPanel>
    </Grid>
</Window>

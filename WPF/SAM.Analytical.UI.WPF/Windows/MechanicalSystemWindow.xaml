<Window x:Class="SAM.Analytical.UI.WPF.MechanicalSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Analytical.UI.WPF"
        mc:Ignorable="d"
        Title="Mechanical System" Height="240" Width="420" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBox_FullName" Grid.Row="0" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" Margin="0,2"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mechanical System Type" VerticalAlignment="Center"/>
        <ComboBox x:Name="ComboBox_MechanicalSystemType" Grid.Row="1" Grid.Column="1" IsEnabled="False" VerticalAlignment="Center" Margin="0,2"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Id" VerticalAlignment="Center"/>
        <TextBox x:Name="TextBox_Id" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,2"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="0,0,6,0" IsDefault="True" Click="Button_OK_Click"/>
            <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" IsCancel="True" Click="Button_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="SAM.Analytical.UI.WPF.PartOTM59ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Analytical.UI.WPF"
        mc:Ignorable="d"
        Title="Part O Overheating (TM59)" Height="700" Width="1000" FontFamily="Roboto Light">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="textBlock_Summary" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- The production TM59AssessmentReport text, verbatim. No criterion, limit or verdict is
             recomputed for display. -->
        <TextBox x:Name="textBox_Report" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"/>

        <Label x:Name="label_Diagnostics" Grid.Row="2" Content="Spaces not assessed" Margin="0,10,0,0" Padding="0,0,0,2" FontWeight="Bold"/>
        <TextBox x:Name="textBox_Diagnostics" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"/>

        <Button x:Name="button_CopyAll" Grid.Row="4" Width="70" Height="20" Margin="0,6,80,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="button_CopyAll_Click">Copy All</Button>
        <Button x:Name="button_Close" IsCancel="True" Grid.Row="4" Width="60" Height="20" Margin="0,6,10,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="button_Close_Click">Close</Button>
    </Grid>
</Window>

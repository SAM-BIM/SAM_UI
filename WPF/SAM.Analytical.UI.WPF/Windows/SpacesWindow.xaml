<Window x:Class="SAM.Analytical.UI.WPF.SpacesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Analytical.UI.WPF"
        mc:Ignorable="d"
        Title="Spaces" Height="600" Width="1200" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DataGrid_Main" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  MouseDoubleClick="DataGrid_Main_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Space" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Area" Binding="{Binding Area}"/>
                <DataGridTextColumn Header="Occupancy" Binding="{Binding Occupancy}"/>
                <DataGridTextColumn Header="Internal Condition" Binding="{Binding InternalConditionName}"/>
                <DataGridTextColumn Header="Area / Person" Binding="{Binding AreaPerPerson}"/>
                <DataGridTextColumn Header="Heating Profile" Binding="{Binding HeatingProfileName}"/>
                <DataGridTextColumn Header="Heating Design Temp." Binding="{Binding HeatingDesignTemperature}"/>
                <DataGridTextColumn Header="Cooling Profile" Binding="{Binding CoolingProfileName}"/>
                <DataGridTextColumn Header="Cooling Design Temp." Binding="{Binding CoolingDesignTemperature}"/>
                <DataGridTextColumn Header="Occupancy Profile" Binding="{Binding OccupancyProfileName}"/>
                <DataGridTextColumn Header="Occ. Sensible / Person" Binding="{Binding OccupancySensibleGainPerPerson}"/>
                <DataGridTextColumn Header="Occ. Sensible (calc.)" Binding="{Binding OccupancySensibleGainCalculated}"/>
                <DataGridTextColumn Header="Occ. Latent / Person" Binding="{Binding OccupancyLatentGainPerPerson}"/>
                <DataGridTextColumn Header="Occ. Latent (calc.)" Binding="{Binding OccupancyLatentGainCalculated}"/>
                <DataGridTextColumn Header="Lighting Profile" Binding="{Binding LightingProfileName}"/>
                <DataGridTextColumn Header="Lighting Gain" Binding="{Binding LightingGain}"/>
                <DataGridTextColumn Header="Lighting Gain / Area" Binding="{Binding LightingGainPerArea}"/>
                <DataGridTextColumn Header="Lighting Gain (calc.)" Binding="{Binding LightingGainCalculated}"/>
                <DataGridTextColumn Header="Lighting Level" Binding="{Binding LightingLevel}"/>
                <DataGridTextColumn Header="Equip. Sensible Profile" Binding="{Binding EquipmentSensibleProfileName}"/>
                <DataGridTextColumn Header="Equip. Sensible Gain" Binding="{Binding EquipmentSensibleGain}"/>
                <DataGridTextColumn Header="Equip. Sensible / Area" Binding="{Binding EquipmentSensibleGainPerArea}"/>
                <DataGridTextColumn Header="Equip. Sensible (calc.)" Binding="{Binding EquipmentSensibleGainCalculated}"/>
                <DataGridTextColumn Header="Equip. Latent Profile" Binding="{Binding EquipmentLatentProfileName}"/>
                <DataGridTextColumn Header="Equip. Latent Gain" Binding="{Binding EquipmentLatentGain}"/>
                <DataGridTextColumn Header="Equip. Latent / Area" Binding="{Binding EquipmentLatentGainPerArea}"/>
                <DataGridTextColumn Header="Equip. Latent (calc.)" Binding="{Binding EquipmentLatentGainCalculated}"/>
                <DataGridTextColumn Header="Humidification Profile" Binding="{Binding HumidificationProfileName}"/>
                <DataGridTextColumn Header="Humidification" Binding="{Binding Humidification}"/>
                <DataGridTextColumn Header="Dehumidification Profile" Binding="{Binding DehumidificationProfileName}"/>
                <DataGridTextColumn Header="Dehumidification" Binding="{Binding Dehumidification}"/>
                <DataGridTextColumn Header="Infiltration Profile" Binding="{Binding InfiltrationProfileName}"/>
                <DataGridTextColumn Header="Infiltration" Binding="{Binding Infiltration}"/>
                <DataGridTextColumn Header="Ventilation System" Binding="{Binding VentilationSystemTypeName}"/>
                <DataGridTextColumn Header="Heating System" Binding="{Binding HeatingSystemTypeName}"/>
                <DataGridTextColumn Header="Cooling System" Binding="{Binding CoolingSystemTypeName}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" Text="Double-click a row to edit its internal condition." Margin="2,6,0,2" Foreground="Gray"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="Button_OK" Content="OK" Width="75" Height="28" Margin="0,0,6,0" IsDefault="True" Click="Button_OK_Click"/>
            <Button x:Name="Button_Cancel" Content="Cancel" Width="75" Height="28" IsCancel="True" Click="Button_Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
